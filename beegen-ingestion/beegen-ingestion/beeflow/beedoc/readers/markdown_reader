import aiofiles
from pathlib import Path

from beedoc.core.interfaces import DocumentReader
from beedoc.core.entities import DocumentMetadata, DocumentType
from beedoc.core.exceptions import DocumentReadError, DocumentValidationError


class MarkdownReader(DocumentReader):
    """Reader for Markdown documents."""
    
    async def validate_input(self, metadata: DocumentMetadata) -> bool:
        """Validate if the Markdown can be processed."""
        if metadata.document_type != DocumentType.MARKDOWN:
            return False
        
        if metadata.path:
            path = Path(metadata.path)
            if not path.exists():
                raise DocumentValidationError(f"File not found: {metadata.path}")
            
            if path.suffix.lower() not in ['.md', '.markdown']:
                raise DocumentValidationError(f"Expected Markdown file, got: {path.suffix}")
        
        return True
    
    async def read_metadata(self, metadata: DocumentMetadata) -> DocumentMetadata:
        """Read and enrich Markdown metadata."""
        if metadata.content:
            # Extract structure metadata from markdown
            text = metadata.content.decode('utf-8')
            structure_metadata = self._extract_markdown_structure(text)
            metadata.structure_metadata = structure_metadata
            metadata.size_bytes = len(metadata.content)
            return metadata
        
        return metadata
    
    async def read_content(self, metadata: DocumentMetadata) -> bytes:
        """Load Markdown content as bytes."""
        if metadata.content:
            return metadata.content
        
        if not metadata.path:
            raise DocumentReadError("No path or content provided")
        
        try:
            async with aiofiles.open(metadata.path, 'rb') as f:
                content = await f.read()
            
            # Extract structure metadata if not already done
            if not metadata.structure_metadata:
                text = content.decode('utf-8')
            
            return content
                
        except Exception as e:
            raise DocumentReadError(f"Failed to read Markdown file: {e}")